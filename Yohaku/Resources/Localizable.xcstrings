    "settings.tagline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكان هادئ لترك متسع في يومك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein stiller Ort, um Raum in deinen Tag zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet place to leave room in your day."
          }
