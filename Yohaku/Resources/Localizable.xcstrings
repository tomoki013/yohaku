          "stringUnit": {
            "state": "translated",
            "value": "अपने दिन में जगह छोड़ने की एक शांत जगह।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat tenang untuk menyisakan ruang di harimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un luogo tranquillo per lasciare spazio nella giornata."
