        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もしない時間を、予定に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 여백을 두는 조용한 자리."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustige plek om ruimte in je dag te laten."
          }
        },
        "pl": {
