    "legal.english_fallback": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المستند غير متوفر بلغتك بعد، لذا يتم عرض النسخة الإنجليزية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument ist noch nicht in deiner Sprache verfügbar, daher wird die englische Fassung angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document is not yet available in your language, so the English version is shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento aún no está disponible en tu idioma, por lo que se muestra la versión en inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document n'est pas encore disponible dans votre langue ; la version anglaise est affichée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दस्तावेज़ अभी आपकी भाषा में उपलब्ध नहीं है, इसलिए अंग्रेज़ी संस्करण दिखाया जा रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen ini belum tersedia dalam bahasa Anda, jadi versi bahasa Inggris ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo documento non è ancora disponibile nella tua lingua, quindi viene mostrata la versione inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書はお使いの言語ではまだ用意されていないため、英語版を表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 사용 중인 언어로 아직 제공되지 않아 영어판을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document is nog niet in jouw taal beschikbaar; daarom wordt de Engelse versie getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dokument nie jest jeszcze dostępny w Twoim języku, dlatego wyświetlana jest wersja angielska."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento ainda não está disponível no seu idioma, então a versão em inglês é exibida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารนี้ยังไม่มีในภาษาของคุณ จึงแสดงฉบับภาษาอังกฤษ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu belge henüz dilinizde mevcut değil, bu yüzden İngilizce sürüm gösteriliyor."
