        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj iletilemedi. Daha sonra tekrar dene."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gửi tin nhắn. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咨询未能送达，请稍后重试。"
