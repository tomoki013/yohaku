    "legal.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل بالإنترنت. يتم عرض النسخة المضمّنة في التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Die in der App gespeicherte Fassung wird angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline. The copy bundled with the app is shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Se muestra la copia incluida en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. La copie fournie avec l'app est affichée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। ऐप में शामिल प्रति दिखाई जा रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Salinan yang disertakan dalam aplikasi ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Viene mostrata la copia inclusa nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインのため、アプリに保存されている内容を表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이므로 앱에 저장된 내용을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. De in de app opgenomen versie wordt getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Wyświetlana jest kopia dołączona do aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está off-line. A cópia incluída no app é exibida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ จึงแสดงสำเนาที่มาพร้อมกับแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısın. Uygulamayla birlikte gelen kopya gösteriliyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Bản đi kèm ứng dụng được hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前处于离线状态，显示应用内保存的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前處於離線狀態，顯示應用程式內保存的內容。"
          }
        }
      }
    },
    "legal.online_required": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بالإنترنت لعرض أحدث إفصاح على موقع يوهاكو الرسمي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle eine Internetverbindung her, um die neuesten Angaben auf der offiziellen Yohaku-Website zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet to view the latest disclosure on the official Yohaku website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet para ver la información más reciente en el sitio oficial de Yohaku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Internet pour consulter les informations les plus récentes sur le site officiel de Yohaku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधिकारिक योहाकु वेबसाइट पर नवीनतम जानकारी देखने के लिए इंटरनेट से कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan ke internet untuk melihat pengungkapan terbaru di situs resmi Yohaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegati a internet per consultare l'informativa più recente sul sito ufficiale di Yohaku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式Yohakuサイトで最新の表記を確認するには、インターネットに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 Yohaku 사이트에서 최신 표기를 확인하려면 인터넷에 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met internet om de nieuwste informatie op de officiële Yohaku-site te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z internetem, aby zobaczyć najnowsze informacje na oficjalnej stronie Yohaku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para ver as informações mais recentes no site oficial do Yohaku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่ออินเทอร์เน็ตเพื่อดูข้อมูลล่าสุดบนเว็บไซต์ทางการของ Yohaku"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En güncel bildirimi resmî Yohaku sitesinde görmek için internete bağlan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kết nối internet để xem thông tin mới nhất trên trang chính thức của Yohaku."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接互联网，以在 Yohaku 官方网站查看最新标示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連接網際網路，以在 Yohaku 官方網站查看最新標示。"
          }
        }
      }
