    "purchase.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية شراء واحدة تزيل الإعلانات من يوهاكو نهائيًا. تبقى كل الميزات الأساسية مجانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmaliger Kauf entfernt die Werbung in Yohaku dauerhaft. Alle Kernfunktionen bleiben kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time purchase permanently removes ads from Yohaku. Every core feature stays free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra única elimina para siempre los anuncios de Yohaku. Todas las funciones básicas siguen siendo gratuitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat unique supprime définitivement les publicités de Yohaku. Toutes les fonctions essentielles restent gratuites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की खरीद से योहाकु से विज्ञापन हमेशा के लिए हट जाते हैं। सभी मुख्य सुविधाएँ मुफ़्त रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali beli, iklan di Yohaku hilang selamanya. Semua fitur inti tetap gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acquisto una tantum rimuove per sempre le pubblicità da Yohaku. Tutte le funzioni principali restano gratuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、Yohakuから広告が永久になくなります。機能は無料のまま、これからも静かに使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 구입으로 Yohaku에서 광고가 영구히 사라집니다. 기본 기능은 계속 무료입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén aankoop verwijdert advertenties definitief uit Yohaku. Alle kernfuncties blijven gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowy zakup trwale usuwa reklamy z Yohaku. Wszystkie podstawowe funkcje pozostają bezpłatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra única remove os anúncios do Yohaku para sempre. Todos os recursos principais continuam gratuitos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว โฆษณาใน Yohaku จะหายไปตลอด ฟีเจอร์หลักทั้งหมดยังคงฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma, Yohaku'daki reklamları kalıcı olarak kaldırır. Tüm temel özellikler ücretsiz kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần mua sẽ xoá quảng cáo khỏi Yohaku vĩnh viễn. Mọi tính năng cốt lõi vẫn miễn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，Yohaku 的广告永久消失。所有核心功能保持免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買，Yohaku 的廣告永久消失。所有核心功能維持免費。"
          }
        }
      }
    },
