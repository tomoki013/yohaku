    "support.error.delivery_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسليم الرسالة. حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht konnte nicht zugestellt werden. Bitte versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message could not be delivered. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo entregar el mensaje. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n'a pas pu être remis. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश वितरित नहीं हो सका। बाद में प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan tidak dapat dikirim. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recapitare il messaggio. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせを配信できませんでした。時間をおいてお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문의를 전달하지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht kon niet worden bezorgd. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dostarczyć wiadomości. Spróbuj później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entregar a mensagem. Tente mais tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถส่งข้อความได้ กรุณาลองใหม่ภายหลัง"
