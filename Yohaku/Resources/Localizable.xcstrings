    "settings.contact.api_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإرسال، تُرسل الفئة والاسم (اختياري) والبريد الإلكتروني والموضوع والرسالة وإصدار التطبيق ورقم البناء وإصدار النظام ولغة العرض ووقت الإرسال ومعرّفات استفسار عشوائية إلى واجهة الدعم المشتركة. لا تُرفق سجلات يوهاكو أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Senden werden Kategorie, Name (optional), E-Mail, Betreff, Nachricht, App-Version, Build-Nummer, OS-Version, Sprache, Sendezeit und zufällige Anfrage-Kennungen an die gemeinsame Support-API übertragen. Yohaku-Einträge werden nie angehängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you submit, your category, name (optional), email, subject, message, app version, build number, OS version, language, submission time, and random inquiry identifiers are sent to the shared support API. Yohaku records are never attached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al enviar, se transmiten a la API de soporte compartida la categoría, el nombre (opcional), el correo, el asunto, el mensaje, la versión de la app, el número de compilación, la versión del sistema, el idioma, la hora de envío e identificadores aleatorios de consulta. Nunca se adjuntan tus registros de Yohaku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'envoi, la catégorie, le nom (facultatif), l'e-mail, l'objet, le message, la version de l'app, le numéro de build, la version du système, la langue, l'heure d'envoi et des identifiants de demande aléatoires sont transmis à l'API d'assistance commune. Vos enregistrements Yohaku ne sont jamais joints."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने पर श्रेणी, नाम (वैकल्पिक), ईमेल, विषय, संदेश, ऐप संस्करण, बिल्ड नंबर, OS संस्करण, भाषा, भेजने का समय और यादृच्छिक पूछताछ पहचानकर्ता साझा सहायता API को भेजे जाते हैं। योहाकु के रिकॉर्ड कभी संलग्न नहीं होते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dikirim, kategori, nama (opsional), email, subjek, pesan, versi aplikasi, nomor build, versi OS, bahasa, waktu pengiriman, dan pengidentifikasi acak dikirim ke API dukungan bersama. Catatan Yohaku tidak pernah dilampirkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'invio, categoria, nome (facoltativo), e-mail, oggetto, messaggio, versione dell'app, numero di build, versione del sistema, lingua, ora di invio e identificatori casuali vengono inviati all'API di assistenza condivisa. I tuoi dati Yohaku non vengono mai allegati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信すると、カテゴリ、氏名（任意）、メールアドレス、件名、内容、アプリバージョン、ビルド番号、OSバージョン、表示言語、送信日時、ランダムな問い合わせ識別子が共通サポートAPIへ送信されます。余白の記録が添付されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내면 카테고리, 이름(선택), 이메일 주소, 제목, 내용, 앱 버전, 빌드 번호, OS 버전, 표시 언어, 전송 일시, 무작위 문의 식별자가 공통 지원 API로 전송됩니다. 여백 기록이 첨부되는 일은 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij verzending worden categorie, naam (optioneel), e-mail, onderwerp, bericht, appversie, buildnummer, OS-versie, taal, verzendtijd en willekeurige aanvraag-ID's naar de gedeelde support-API gestuurd. Yohaku-gegevens worden nooit bijgevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wysłaniu kategoria, imię (opcjonalnie), e-mail, temat, treść, wersja aplikacji, numer kompilacji, wersja systemu, język, czas wysyłki i losowe identyfikatory zgłoszenia trafiają do wspólnego API wsparcia. Zapisy Yohaku nigdy nie są dołączane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao enviar, categoria, nome (opcional), e-mail, assunto, mensagem, versão do app, número da build, versão do sistema, idioma, horário de envio e identificadores aleatórios são enviados à API de suporte compartilhada. Seus registros do Yohaku nunca são anexados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อส่ง ประเภท ชื่อ (ไม่บังคับ) อีเมล หัวข้อ เนื้อหา เวอร์ชันแอป หมายเลขบิลด์ เวอร์ชัน OS ภาษา เวลาที่ส่ง และตัวระบุคำถามแบบสุ่ม จะถูกส่งไปยัง API ฝ่ายสนับสนุนส่วนกลาง บันทึกใน Yohaku จะไม่ถูกแนบไปด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiğinde kategori, ad (isteğe bağlı), e-posta, konu, mesaj, uygulama sürümü, derleme numarası, işletim sistemi sürümü, dil, gönderim zamanı ve rastgele talep tanımlayıcıları ortak destek API'sine iletilir. Yohaku kayıtların asla eklenmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi gửi, loại yêu cầu, tên (không bắt buộc), email, tiêu đề, nội dung, phiên bản ứng dụng, số bản dựng, phiên bản hệ điều hành, ngôn ngữ, thời điểm gửi và mã yêu cầu ngẫu nhiên sẽ được gửi tới API hỗ trợ dùng chung. Dữ liệu Yohaku không bao giờ được đính kèm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送时，类别、姓名（可选）、邮箱、主题、内容、应用版本、构建号、系统版本、显示语言、发送时间以及随机咨询标识符会发送至共用支持 API。你的余白记录不会被附加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送時，類別、姓名（選填）、信箱、主旨、內容、應用程式版本、建置編號、系統版本、顯示語言、傳送時間以及隨機諮詢識別碼會傳送至共用支援 API。你的餘白記錄不會被附加。"
          }
        }
      }
    },
