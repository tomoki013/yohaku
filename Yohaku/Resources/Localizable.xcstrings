      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقترب موعد مساحتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bald ist es Zeit für deinen Freiraum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost time for your space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya casi es hora de tu espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est bientôt l'heure de votre espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खाली जगह का समय होने वाला है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebentar lagi waktunya ruang Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È quasi il momento del tuo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そろそろ、余白の時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧 여백의 시간입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna tijd voor je ruimte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już prawie czas na twoją przestrzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está quase na hora do seu espaço."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใกล้ถึงเวลาพื้นที่ว่างของคุณแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk zamanınız yaklaşıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp đến giờ khoảng trống của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快到留白时间了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快到留白時間了。"
          }
        }
