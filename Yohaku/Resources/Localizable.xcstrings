    "onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطِ المساحة اسمًا ووقتًا، ثم انظر إليها بهدوء في عرض اليوم والأسبوع والشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deiner Auszeit einen Namen und eine Zeit. Blicke dann ruhig auf Heute, Woche und Monat zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a space a name and time. Then look back across quiet Today, Week, and Month views."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre y una hora a tu espacio. Luego revísalo con calma en Hoy, Semana y Mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne un nom et une heure à ton espace, puis retrouve-le calmement dans Aujourd'hui, Semaine et Mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नाम और समय के साथ स्थान बनाएं। फिर आज, सप्ताह और महीने में शांति से देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri nama dan waktu pada ruangmu. Lihat kembali dengan tenang di tampilan Hari ini, Minggu, dan Bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome e un orario al tuo spazio. Poi rivedilo con calma in Oggi, Settimana e Mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と時間を決めるだけ。今日・週・月の静かな画面で、自分の余白を振り返れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 시간을 정해 여백을 만들어보세요. 오늘・주・월 화면에서 조용히 되돌아볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je ruimte een naam en tijd. Bekijk het daarna rustig terug in Vandaag, Week en Maand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj swojej przestrzeni nazwę i czas. Potem spokojnie spójrz na nią w widokach Dziś, Tydzień i Miesiąc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome e um horário ao seu espaço. Depois reveja com calma em Hoje, Semana e Mês."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อและเวลาให้กับช่วงเวลาว่างของคุณ แล้วมองย้อนกลับไปอย่างเงียบๆ ในมุมมองวันนี้ สัปดาห์ และเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluğuna bir isim ve zaman ver. Sonra Bugün, Hafta ve Ay görünümlerinde sakince geri bak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên và thời gian cho khoảng trống của bạn. Rồi nhìn lại thật yên tĩnh ở Hôm nay, Tuần và Tháng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为余白起个名字，定好时间。然后在今天、本周、本月中静静回顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為餘白取個名字，訂好時間。然後在今天、本週、本月中靜靜回顧。"
          }
        }
      }
    },
